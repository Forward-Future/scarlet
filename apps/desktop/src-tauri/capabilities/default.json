{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs plus the plugins the Scarlet UI calls directly.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "dialog:default",
    "opener:default",
    "log:default",
    "window-state:default"
  ]
}
