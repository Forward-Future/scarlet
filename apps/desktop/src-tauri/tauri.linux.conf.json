{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb"],
    "externalBin": [],
    "resources": {
      "binaries/scarlet-engine-x86_64-unknown-linux-gnu": "scarlet-engine",
      "binaries/whisper-cli-x86_64-unknown-linux-gnu": "whisper-cli",
      "binaries/whisper-cpu/whisper-cli": "whisper-cpu/whisper-cli"
    },
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav",
          "gstreamer1.0-pulseaudio",
          "bubblewrap",
          "socat",
          "libnss3",
          "libnspr4",
          "libgbm1",
          "libasound2t64 | libasound2",
          "libatk-bridge2.0-0t64 | libatk-bridge2.0-0",
          "libatk1.0-0t64 | libatk1.0-0",
          "libatspi2.0-0t64 | libatspi2.0-0",
          "libdbus-1-3",
          "libexpat1",
          "libudev1",
          "libx11-6",
          "libxcb1",
          "libxcomposite1",
          "libxdamage1",
          "libxext6",
          "libxfixes3",
          "libxkbcommon0",
          "libxrandr2",
          "fonts-liberation"
        ],
        "files": {
          "/etc/apparmor.d/scarlet-chrome-headless-shell": "linux/scarlet-chrome-headless-shell.apparmor"
        },
        "postInstallScript": "linux/postinst.sh",
        "preRemoveScript": "linux/prerm.sh"
      }
    }
  }
}
