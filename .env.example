# Scarlet server configuration. Copy to .env (never commit .env).

# Where projects, media, renders and the SQLite database live.
SCARLET_DATA=./data
SCARLET_PORT=4000

# The desktop app receives the engine token through its native startup handshake.
# Headless CLI clients can use the token kept in $SCARLET_DATA/access-token.

# Transcription. Scarlet needs word-timed transcripts for dialogue cuts.
# Choose your model in App Settings → General. Scarlet uses bundled Whisper until CrisperWhisper is installed.
# Custom adapter paths are in Advanced. To enable cloud transcription, select OpenAI Whisper and set this key.
# OPENAI_API_KEY=sk-...

# Optional: cleans up rambling voice notes into precise agent instructions.
# ANTHROPIC_API_KEY=sk-ant-...

# Override ffmpeg/ffprobe binaries if they are not on PATH.
# FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\tools\ffmpeg\bin\ffprobe.exe

# Anonymous usage reports (see docs/telemetry.md). Set to false to turn them off.
# SCARLET_TELEMETRY_ENABLED=false
# Packaged releases use the Scarlet project. Set a project token to report from a source build.
# SCARLET_POSTHOG_KEY=phc_...
# SCARLET_POSTHOG_HOST=https://us.i.posthog.com
