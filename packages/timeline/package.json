{
  "name": "@scarlet/timeline",
  "version": "0.1.4",
  "description": "Scarlet cut-list schema, operations, diffing and interchange (OTIO).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "color-name": "2.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/color-name": "^2.0.0"
  }
}
